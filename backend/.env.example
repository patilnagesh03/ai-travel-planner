# ==========================
# Django Settings
# ==========================
# Required in production. When DEBUG=False the project refuses to start
# without a real key, and rejects placeholder or "django-insecure-" values.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Keep True for local development. Production must set DEBUG=False.
DEBUG=True

# Comma separated. Required when DEBUG=False (there is no wildcard default).
ALLOWED_HOSTS=127.0.0.1,localhost

# ==========================
# PostgreSQL Database
# ==========================
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ==========================
# JWT Settings
# ==========================
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=7

# ==========================
# CORS / Frontend
# ==========================
# Origins allowed to call the API from a browser. Comma separated, no
# trailing slash. When unset, FRONTEND_URL is used. There is no
# allow-all switch, on purpose.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Send cookies with cross-origin requests. Leave False unless the frontend
# authenticates with cookies rather than the JWT Authorization header.
CORS_ALLOW_CREDENTIALS=False

# ==========================
# Integrations (OpenStreetMap / Overpass)
# ==========================
# The Overpass usage policy asks every client to identify itself with a
# meaningful User-Agent that offers a way to reach the operator. Replace the
# value below with a real contact address that you control.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_CONNECT_TIMEOUT=5
OVERPASS_READ_TIMEOUT=30
OVERPASS_QUERY_TIMEOUT=20
MAX_PLACES_PER_SEARCH=20
INTEGRATIONS_USER_AGENT=AITravelPlanner/1.0 (nageshpatil7311@gmail.com)

# Force IPv4 when calling the provider.
# Turn this on if your network advertises IPv6 addresses for the host but
# cannot actually route IPv6 traffic, which makes every request hang until
# it times out. Leave it off for an IPv6-only network.
OVERPASS_IPV4_ONLY=False

# Set to 1 to enable the opt-in live test against the real Overpass provider.
OVERPASS_LIVE_TEST=0

# ==========================
# Weather (Open-Meteo)
# ==========================
# No API key is needed. Open-Meteo publishes at most 16 days of daily
# forecast, so WEATHER_FORECAST_DAYS is capped at 16.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CONNECT_TIMEOUT=5
WEATHER_READ_TIMEOUT=15
WEATHER_FORECAST_DAYS=16
WEATHER_CACHE_TIMEOUT=900

# ==========================
# Currency (Frankfurter)
# ==========================
# No API key is needed. Rates come from the European Central Bank and
# change once per working day.
CURRENCY_API_URL=https://api.frankfurter.dev/v1
CURRENCY_CONNECT_TIMEOUT=5
CURRENCY_READ_TIMEOUT=10
CURRENCY_CACHE_TIMEOUT=3600
MAX_CURRENCY_SYMBOLS=12

# ==========================
# AI Configuration
# ==========================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.4
