# ==========================
# Django Settings
# ==========================
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ==========================
# PostgreSQL Database
# ==========================
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ==========================
# JWT Settings
# ==========================
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=7

# ==========================
# External APIs
# ==========================
WEATHER_API_KEY=
CURRENCY_API_KEY=
PLACES_API_KEY=

# ==========================
# Integrations (OpenStreetMap / Overpass)
# ==========================
# The Overpass usage policy asks every client to identify itself with a
# meaningful User-Agent that offers a way to reach the operator. Replace the
# value below with a real contact address that you control.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_CONNECT_TIMEOUT=5
OVERPASS_READ_TIMEOUT=30
OVERPASS_QUERY_TIMEOUT=20
MAX_PLACES_PER_SEARCH=20
INTEGRATIONS_USER_AGENT=AITravelPlanner/1.0 (nageshpatil7311@gmail.com)

# Force IPv4 when calling the provider.
# Turn this on if your network advertises IPv6 addresses for the host but
# cannot actually route IPv6 traffic, which makes every request hang until
# it times out. Leave it off for an IPv6-only network.
OVERPASS_IPV4_ONLY=False

# Set to 1 to enable the opt-in live test against the real Overpass provider.
OVERPASS_LIVE_TEST=0

# ==========================
# AI Configuration
# ==========================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.4
OPENAI_API_KEY=

# ==========================
# Email Configuration
# ==========================
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ==========================
# Frontend
# ==========================
FRONTEND_URL=http://localhost:5173

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO  